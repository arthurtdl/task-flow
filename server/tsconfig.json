{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node", "jest"],
    "paths": {
      "@database": ["./src/database/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "prisma.config.ts"]
}